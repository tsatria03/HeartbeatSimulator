#include"sound_pool.nvgt"
#include"speech.nvgt"
int heartslot;
    int respslot=-1;
int resptype=0;
int bpm=40, respset=0, scopetime=1600, hearttype=1, heartsound=1;
timer scopetimer;
sound_pool pool;
void main()
{
show_window("HeartbeatSimulator");
heartsim();
}
void heartsim()
{
while(true)
{
wait(5);
if(heartsound==1)
{
    int newresptype=0;
    if(bpm>=55 and bpm<=155)
    {
        if(bpm<=70) newresptype=1;
        else if(bpm<=90) newresptype=2;
        else if(bpm<=120) newresptype=3;
        else newresptype=4;
    }
    if(newresptype!=resptype)
    {
        if(respslot!=-1)
        {
            pool.destroy_sound(respslot);
            respslot=-1;
        }
        resptype=newresptype;
        if(resptype>0)
        {
            respslot=pool.play_stationary_extended("sounds/respiration"+resptype+".wav", true, 0, 0, -5, 100, false);
        }
    }
}
if(heartsound==1 and scopetimer.elapsed>=scopetime)
{
heartslot = pool.play_stationary("sounds/heartbeat"+hearttype+".wav", false);
scopetimer.restart();
}
if(key_repeating(KEY_T))
{
speak("heart type, "+hearttype);
}
if(key_repeating(KEY_H))
{
speak("heart rate, "+bpm+" beats per minute.");
}
if(key_repeating(KEY_RETURN))
{
if(heartsound==1)
{
heartsound=0;
if(respslot!=-1)
{
pool.destroy_sound(respslot);
respslot=-1;
}
resptype=0;
pool.destroy_sound(heartslot);
pool.play_stationary("sounds/toggleoff.ogg",false);
speak("Heart monitor off.");
}
else
{
heartsound=1;
pool.play_stationary("sounds/toggleon.ogg",false);
speak("Heart monitor on.");
}
}
if(key_repeating(KEY_UP) and bpm!=195)
{
bpm+=5;
scopetime-=50;
if(respset==1)
{
if(respslot!=-1)
{
pool.destroy_sound(respslot);
respslot=-1;
}
resptype=0;
}
speak(bpm);
}
if (key_repeating(KEY_DOWN) and bpm!=5)
{
bpm-=5;
scopetime+=50;
if(respset==1)
{
if(respslot!=-1)
{
pool.destroy_sound(respslot);
respslot=-1;
}
resptype=0;
}
speak(bpm);
}
if(key_repeating(KEY_LEFT) and hearttype!=1)
{
hearttype-=1;
if(respset==1)
{
if(respslot!=-1)
{
pool.destroy_sound(respslot);
respslot=-1;
}
resptype=0;
}
speak(hearttype);
}
if(key_repeating(KEY_RIGHT) and hearttype!=3)
{
hearttype+=1;
if(respset==1)
{
if(respslot!=-1)
{
pool.destroy_sound(respslot);
respslot=-1;
}
resptype=0;
}
speak(hearttype);
}
if(key_repeating(KEY_ESCAPE))
{
exit();
}
}
}
