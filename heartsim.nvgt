#include"sound_pool.nvgt"
#include"speech.nvgt"
int heartslot;
int bpm=5, scopetime=1950, hearttype=1, heartsound=1;
timer scopetimer;
sound_pool pool;
void main()
{
show_window("HeartbeatSimulator");
heartsim();
}
void heartsim()
{
while(true)
{
wait(5);
if(heartsound==1 and scopetimer.elapsed>=scopetime)
{
if(hearttype==1)
{
heartslot=pool.play_stationary("sounds/heartbeat1.wav", false);
scopetimer.restart();
}
if(hearttype==2)
{
heartslot=pool.play_stationary("sounds/heartbeat2.wav",false);
scopetimer.restart();
}
if(hearttype==3)
{
heartslot=pool.play_stationary("sounds/heartbeat3.wav",false);
scopetimer.restart();
}
}
if(key_repeating(KEY_T))
{
speak("heart type, "+hearttype);
}
if(key_repeating(KEY_H))
{
speak("heart rate, "+bpm+" beats per minute.");
}
if(key_repeating(KEY_RETURN))
{
if(heartsound==1)
{
heartsound=0;
pool.destroy_sound(heartslot);
pool.play_stationary("sounds/toggleoff.ogg", false);
speak("Heart monidor off.");
}
else
{
heartsound=1;
pool.play_stationary("sounds/toggleon.ogg", false);
speak("Heart monidor on.");
}
}
if(key_repeating(KEY_UP) and bpm!=195)
{
bpm+=5;
scopetime-=50;
speak(bpm);
}
if (key_repeating(KEY_DOWN) and bpm!=5)
{
bpm-=5;
scopetime+=50;
speak(bpm);
}
if(key_repeating(KEY_LEFT) and hearttype!=1)
{
hearttype-=1;
speak(hearttype);
}
if(key_repeating(KEY_RIGHT) and hearttype!=3)
{
hearttype+=1;
speak(hearttype);
}
if(key_repeating(KEY_ESCAPE))
{
exit();
}
}
}
